{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Jekyll Live Server",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload --port 8080 --host 0.0.0.0",
      "isBackground": true,
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Jekyll Site",
      "type": "shell",
      "command": "bundle exec jekyll build",
      "problemMatcher": []
    },
    {
      "label": "Watch & Build Jekyll Site",
      "type": "shell",
      "command": "bundle exec jekyll build --watch",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}

