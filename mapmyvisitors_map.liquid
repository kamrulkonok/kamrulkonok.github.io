<div class="visitor-map-card">
  <div class="visitor-map-head">
    <h3 class="visitor-map-title">Global Visitors</h3>
    <p class="visitor-map-subtitle">Hover a country to view its visitor count</p>
  </div>
  <div id="visitor-country-map" class="visitor-country-map" aria-label="World visitor map"></div>
  <div id="visitor-country-list" class="visitor-country-list" aria-live="polite"></div>
</div>

<style>
  .visitor-map-card {
    margin: 1.25rem 0 1.5rem;
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--global-divider-color);
    background: linear-gradient(165deg, var(--global-card-bg-color), rgba(90, 130, 180, 0.08));
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.09);
  }

  .visitor-map-head {
    margin-bottom: 0.55rem;
  }

  .visitor-map-title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .visitor-map-subtitle {
    margin: 0.15rem 0 0;
    font-size: 0.86rem;
    opacity: 0.8;
  }

  .visitor-country-map {
    width: 100%;
    min-height: 360px;
  }

  .visitor-country-list {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .visitor-country-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--global-divider-color);
    background: color-mix(in srgb, var(--global-bg-color) 86%, transparent);
    font-size: 0.79rem;
    line-height: 1.2;
  }

  .visitor-country-pill-count {
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .visitor-country-map {
      min-height: 300px;
    }
  }
</style>

<script>
  (function () {
    const card = document.currentScript.previousElementSibling.previousElementSibling;
    if (!card) return;

    const mapEl = card.querySelector("#visitor-country-map");
    const listEl = card.querySelector("#visitor-country-list");
    if (!mapEl || !listEl) return;

    const DATA_URL_BASE =
      "https://mapmyvisitors.com/widget_call_home.js?d=XICOOJzK6XIgLX2kz4L5Bkn1GgZK2XYqmL_RijOoofA&w=520&t=m&cl=ffffff";

    function getTheme() {
      const t = document.documentElement.getAttribute("data-theme");
      if (t === "dark" || t === "light") return t;
      return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    }

    function getCountryName(locationText) {
      const trimmed = (locationText || "").trim();
      if (!trimmed) return null;
      if (trimmed.toLowerCase() === "unknown location") return null;
      if (trimmed.includes(",")) {
        return trimmed.split(",").pop().trim();
      }
      return trimmed;
    }

    function parseCountryCounts(rawText) {
      const counts = new Map();
      const markerRegex = /name:\s*(?:\\")?(\d+)\s+visits?\s+from\s+([^"\\]+)(?:\\")?/gi;
      let match;

      while ((match = markerRegex.exec(rawText)) !== null) {
        const visits = parseInt(match[1], 10);
        if (!Number.isFinite(visits)) continue;

        const country = getCountryName(match[2]);
        if (!country) continue;

        counts.set(country, (counts.get(country) || 0) + visits);
      }

      return Array.from(counts.entries())
        .map((entry) => ({ country: entry[0], count: entry[1] }))
        .sort((a, b) => b.count - a.count);
    }

    function renderCountryList(items) {
      if (!items.length) {
        listEl.innerHTML = '<span class="visitor-map-subtitle">No country data available yet.</span>';
        return;
      }

      listEl.innerHTML = items
        .slice(0, 10)
        .map(function (item) {
          return (
            '<span class="visitor-country-pill">'
            + '<span class="visitor-country-pill-count">' + item.count + "</span>"
            + " people from "
            + item.country
            + "</span>"
          );
        })
        .join("");
    }

    function ensurePlotly() {
      if (window.Plotly) return Promise.resolve();
      return new Promise(function (resolve, reject) {
        const existing = document.querySelector('script[data-visitor-map-plotly="1"]');
        if (existing) {
          existing.addEventListener("load", resolve, { once: true });
          existing.addEventListener("error", reject, { once: true });
          return;
        }

        const s = document.createElement("script");
        s.src = "https://cdn.plot.ly/plotly-2.35.2.min.js";
        s.async = true;
        s.dataset.visitorMapPlotly = "1";
        s.onload = resolve;
        s.onerror = reject;
        document.head.appendChild(s);
      });
    }

    function loadDataJsonp() {
      return new Promise(function (resolve, reject) {
        const callbackName = "visitorMapCb_" + Date.now() + "_" + Math.floor(Math.random() * 1000);
        const script = document.createElement("script");
        script.src = DATA_URL_BASE + "&callback=" + callbackName;
        script.async = true;

        const timeoutId = window.setTimeout(function () {
          cleanup();
          reject(new Error("JSONP timeout"));
        }, 8000);

        function cleanup() {
          window.clearTimeout(timeoutId);
          if (script.parentNode) script.parentNode.removeChild(script);
          try {
            delete window[callbackName];
          } catch (_e) {
            window[callbackName] = undefined;
          }
        }

        window[callbackName] = function (payload) {
          cleanup();
          resolve(String(payload || ""));
        };

        script.onerror = function () {
          cleanup();
          reject(new Error("JSONP load failed"));
        };

        document.head.appendChild(script);
      });
    }

    function renderMap(items) {
      if (!window.Plotly) return;

      const theme = getTheme();
      const isDark = theme === "dark";
      const textColor = isDark ? "#d6dee6" : "#1f2a37";
      const lineColor = isDark ? "#253042" : "#d8dfeb";

      const trace = {
        type: "choropleth",
        locationmode: "country names",
        locations: items.map(function (d) {
          return d.country;
        }),
        z: items.map(function (d) {
          return d.count;
        }),
        colorscale: [
          [0, "#d5e8ff"],
          [0.35, "#7bb4f5"],
          [0.7, "#367fd8"],
          [1, "#0e4f9e"]
        ],
        marker: {
          line: {
            color: lineColor,
            width: 0.6
          }
        },
        colorbar: {
          title: "Visitors",
          tickfont: { color: textColor },
          titlefont: { color: textColor },
          len: 0.72,
          thickness: 10
        },
        hovertemplate: "%{z} people from %{location}<extra></extra>"
      };

      const layout = {
        margin: { t: 8, r: 8, b: 8, l: 8 },
        paper_bgcolor: "rgba(0,0,0,0)",
        plot_bgcolor: "rgba(0,0,0,0)",
        geo: {
          projection: { type: "natural earth" },
          showframe: false,
          showcoastlines: false,
          showcountries: true,
          countrycolor: lineColor,
          bgcolor: "rgba(0,0,0,0)"
        },
        font: { color: textColor }
      };

      const config = {
        responsive: true,
        displayModeBar: false
      };

      window.Plotly.react(mapEl, [trace], layout, config);
    }

    function renderEmpty(message) {
      mapEl.innerHTML = '<div class="visitor-map-subtitle" style="padding: 1rem;">' + message + "</div>";
      listEl.innerHTML = "";
    }

    function loadAndRender() {
      loadDataJsonp()
        .then(function (raw) {
          const items = parseCountryCounts(raw);
          if (!items.length) {
            renderEmpty("No country visit data is available yet.");
            return;
          }
          renderCountryList(items);
          return ensurePlotly().then(function () {
            renderMap(items);
            return items;
          });
        })
        .then(function (items) {
          if (!items) return;
          const themeObserver = new MutationObserver(function () {
            renderMap(items);
          });
          themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
        })
        .catch(function () {
          renderEmpty("Visitor map is temporarily unavailable.");
        });
    }

    loadAndRender();
  })();
</script>
